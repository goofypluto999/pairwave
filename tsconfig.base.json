{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@pairwave/protocol": ["packages/protocol/src/index.ts"],
      "@pairwave/companion/dist/*": ["packages/companion/src/*"],
      "@pairwave/relay/dist/*": ["packages/relay/src/*"]
    }
  }
}
